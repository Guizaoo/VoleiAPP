{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://voleiapp-production.up.railway.app/api/:path*"
    },
    {
      "source": "/((?!assets/|images/|favicon|privacidade.html$|termos.html$).*)",
      "destination": "/index.html"
    }
  ]
}
